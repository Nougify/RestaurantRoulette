# Copy to .env to override the defaults in roulette/config.py.
# The database defaults already match docker-compose.yml.

DATABASE_URL=postgresql://roulette:roulette@localhost:5433/roulette
TEST_DATABASE_URL=postgresql://roulette:roulette@localhost:5433/roulette_test

# Signs login tokens. Without it a temporary key is generated each time the server starts,
# which signs everyone out on restart. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173
